{
  "name": "@azula-app/openclaw",
  "version": "0.0.5",
  "description": "Drive an OpenClaw bot from your phone over azula — an OpenClaw channel plugin that speaks to the azula MCP bridge.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azula-App/azula-openclaw.git"
  },
  "openclaw": {
    "channel": {
      "id": "azula",
      "label": "azula"
    },
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openclaw": "2026.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "scripts/pair.mjs",
    "openclaw.plugin.json",
    "README.md"
  ],
  "main": "./dist/index.js"
}
